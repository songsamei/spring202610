<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.UserMapper">

	<select id="selectUser" parameterType="hashmap" resultType="com.example.demo.model.User">
		SELECT *
		FROM TBL_USER
		WHERE USER_ID = #{userId}
	</select>
	
	<select id="selectAuth" parameterType="hashmap" resultType="int">
		SELECT COUNT(*)
		FROM TBL_USER
		WHERE USER_ID = #{userId} AND PHONE = #{phone}
	</select>
	
	<insert id="insertUser" parameterType="hashmap">
		INSERT INTO TBL_USER
		VALUES(#{userId}, #{hashPwd}, #{userName}, #{addr}, 'C')
	</insert>
	
	<update id="updateUser" parameterType="hashmap">
		UPDATE TBL_USER SET
			PWD = #{hashPwd}
		WHERE USER_ID = #{userId}
	</update>
	
	
</mapper>
